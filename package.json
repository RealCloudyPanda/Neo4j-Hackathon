{
  "name": "contract-drift",
  "version": "0.1.0",
  "description": "Catch the PR that passes TypeScript but changes what an API field means. A Relate graph of contract fields, usages, tests and hidden links.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "contract-drift": "bin/contract-drift.js"
  },
  "scripts": {
    "analyze": "tsx src/cli/index.ts analyze",
    "build:graph": "tsx src/cli/index.ts build",
    "cypher": "tsx src/cli/index.ts cypher",
    "viewer": "tsx src/cli/index.ts viewer",
    "demo": "tsx src/cli/index.ts demo",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@relate/relate": "^1.1.0",
    "cytoscape": "^3.35.0",
    "express": "^5.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
